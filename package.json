{
  "name": "champions-atlas",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "predev": "node scripts/import-catalog.mjs --if-missing && node scripts/jev-enrich.mjs --if-missing",
    "dev": "vite dev --host 127.0.0.1",
    "prebuild": "node scripts/import-catalog.mjs --if-missing && node scripts/jev-enrich.mjs --if-missing",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && lefthook install",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "line-limit": "bash scripts/check-line-limit.sh",
    "pretypecheck": "node scripts/import-catalog.mjs --if-missing && node scripts/jev-enrich.mjs --if-missing",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "ci": "npm run check && npm run line-limit && npm run typecheck && npm run build && npm test",
    "test": "node --test test/*.test.mjs",
    "import:catalog": "node scripts/import-catalog.mjs",
    "sync:stats": "node scripts/sync-stats.mjs",
    "enrich:tags": "node scripts/jev-enrich.mjs",
    "eval:tags": "node scripts/jev-eval.mjs",
    "publish:catalog": "node scripts/publish-catalog.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.57.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "bits-ui": "^2.19.5",
    "csv-parse": "^7.0.3",
    "daisyui": "^5.7.50",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "parse5": "5.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "fsevents": false,
    "lefthook": true
  },
  "overrides": {
    "@google-cloud/pubsub": "^6.3.1",
    "@grpc/grpc-js": "^1.14.6",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": "^24.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource-variable/nunito": "^5.3.0",
    "@smogon/calc": "0.12.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  }
}
